Sub Process_Globals
	Public ActionBarHomeClicked As Boolean
End Sub

Sub Globals
	Private ime As IME
End Sub

Sub Activity_Create (FirstTime As Boolean)
	ime.Initialize("IME")
	ime.AddHeightChangedEvent
	Dim pm As B4XPagesManager
	pm.Initialize(Activity)
End Sub

Sub IME_HeightChanged (NewHeight As Int, OldHeight As Int)
	B4XPages.GetManager.RaiseEvent(B4XPages.GetManager.GetTopPage, "IME_HeightChanged", Array(NewHeight, OldHeight))
End Sub

Public Sub ShowResolutionDialog (SettingsStatus As LocationSettingsStatus) As ResumableSub
	SettingsStatus.StartResolutionDialog("srd")
	Wait For srd_ResolutionDialogDismissed(LocationSettingsUpdated As Boolean)
	Return LocationSettingsUpdated
End Sub

#Region Pin to Home Screen
' Returns True only on the very first launch (persisted flag in DirInternal).
Private Sub FirstRunPinNeeded As Boolean
	#If B4A
	Dim flagFile As String = "daisy_pin_asked.dat"
	If File.Exists(File.DirInternal, flagFile) Then Return False
	Try
		File.WriteString(File.DirInternal, flagFile, "1")
	Catch
		Log("PinToHome flag write failed: " & LastException)
	End Try
	Return True
	#Else
	Return False
	#End If
End Sub

' Asks the default launcher to pin a B4XDaisy UIKit shortcut on the home screen.
' Shows the system Add automatically? dialog (a single tap by the user). No-op below API 26.
Private Sub TryPinToHomeScreen
	'The actual work is done in inline Java (_pinToHome) to avoid JavaObject
	'constructor/method type-matching issues (Context / CharSequence params).
	#If B4A
	Try
		Dim jo As JavaObject
		jo.InitializeStatic("com.example.myapp.main")
		jo.RunMethod("_pinToHome", Null)
	Catch
		Log("TryPinToHomeScreen failed: " & LastException)
	End Try
	#End If
End Sub

#End Region

'Template version: B4A-1.01
#Region Delegates

Sub Activity_ActionBarHomeClick
	ActionBarHomeClicked = True
	B4XPages.Delegate.Activity_ActionBarHomeClick
	ActionBarHomeClicked = False
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean
	Return B4XPages.Delegate.Activity_KeyPress(KeyCode)
End Sub

Sub Activity_Resume
	' One-time prompt: ask the launcher to pin the app icon to the home screen.
	' Uses ShortcutManager.requestPinShortcut (Android 8+). Skipped on older devices.
	Try
		If FirstRunPinNeeded Then TryPinToHomeScreen
	Catch
		Log("PinToHome: " & LastException)
	End Try
	B4XPages.Delegate.Activity_Resume
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	B4XPages.Delegate.Activity_Pause
End Sub

Sub Activity_PermissionResult (Permission As String, Result As Boolean)
	B4XPages.Delegate.Activity_PermissionResult(Permission, Result)
End Sub

Sub Create_Menu (Menu As Object)
	'B4XPages.Delegate.Create_Menu(Menu)
End Sub

